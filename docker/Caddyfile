:80 {
    root * /srv
    encode gzip

    # Flutter web SPA — serve index.html for all unmatched routes
    try_files {path} /index.html
    file_server

    # Cache fingerprinted static assets for 1 year
    @static path *.js *.css *.png *.svg *.ico *.woff *.woff2 *.ttf
    header @static Cache-Control "public, max-age=31536000, immutable"
}
